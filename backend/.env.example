# 生产部署示例：PostgreSQL + Redis + MinIO
SECRET_KEY=please-generate-a-random-64char-secret
DATABASE_URL=postgresql+psycopg2://aigc:aigc@localhost:5432/aigc
USE_REDIS=true
REDIS_URL=redis://localhost:6379/0
USE_MINIO=true
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aigc-assets
TOTAL_GPUS=8

